APP_ENV=development
DATABASE_PATH=./business.db
ADMIN_PASSWORD=choose-a-long-local-password
SESSION_SECRET=replace-with-a-long-random-value
# Public hosting uses the Supabase session pooler connection string.
# Never put real database passwords or secrets in this example file.
DATABASE_URL=
SITE_OPERATOR_NAME=replace-before-public-launch
PRIVACY_CONTACT_EMAIL=replace-before-public-launch
REQUEST_RETENTION_DAYS=30

# Optional AI assistant configuration (keep real keys in hosting secrets only)
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
