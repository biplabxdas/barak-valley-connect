APP_ENV=development
DATABASE_PATH=./business.db
# Set a private owner password before using owner management locally.
ADMIN_PASSWORD=
# Set a random value of at least 32 characters. A local random value is generated if blank.
SESSION_SECRET=
# Use a private PostgreSQL connection URL for a hosted deployment; leave blank for SQLite.
# Never put real database passwords or secrets in this example file.
DATABASE_URL=
SITE_OPERATOR_NAME=replace-before-public-launch
PRIVACY_CONTACT_EMAIL=replace-before-public-launch
REQUEST_RETENTION_DAYS=30

